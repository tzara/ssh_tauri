{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Command Runner",
  "version": "0.1.0",
  "identifier": "com.remote-gui",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Remote Command Runner",
        "width": 1400,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": {
      "../hosts.toml": "hosts.toml"
    }
  }
}
